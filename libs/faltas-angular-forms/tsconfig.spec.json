{
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "types": ["jasmine"],
    "lib": ["ES2022", "dom"],
    "module": "ES2022",
    "target": "ES2022",
    "strict": true,
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "skipLibCheck": true
  },
  "include": ["src/**/*.spec.ts", "src/**/*.d.ts"]
}
